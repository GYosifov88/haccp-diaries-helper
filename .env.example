# OpenAI — extraction, OCR vision, Whisper transcription
OPENAI_API_KEY=sk-...

# Telegram bot (create via @BotFather — never commit the real token)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Google Sheets — service account JSON path + spreadsheet ID
GOOGLE_SHEETS_CREDENTIALS_PATH=./service-account.json
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Optional overrides
TIMEZONE=Europe/Sofia
PENDING_TTL_SECONDS=600
SQLITE_PATH=./data/haccp.db
USERS_CONFIG_PATH=./config/users.yaml
DIARIES_CONFIG_PATH=./config/diaries.yaml
OPENAI_MODEL=gpt-4o-mini
